generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}


// ======================================================
// ENUMS
// ======================================================

enum MemberType {
  HUMAN
  AI
}

enum MemberRole {
  TEAM_LEAD
  DEVELOPER
  AI_DEVELOPER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum WorkItemType {
  FEATURE
  STORY
  BUG
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkItemStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}


// ======================================================
// ORGANIZATION
// ======================================================

model Organization {
  id          String  @id @default(uuid())
  name        String
  description String?

  workspaces Workspace[]
  members    Member[]

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
}


// ======================================================
// WORKSPACE
// ======================================================

model Workspace {
  id             String @id @default(uuid())
  organizationId String

  name        String
  description String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  teams    Team[]
  projects Project[]

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([organizationId])
}


// ======================================================
// MEMBER
// ======================================================

model Member {
  id             String @id @default(uuid())
  organizationId String

  name  String
  email String

  type   MemberType
  role   MemberRole
  status MemberStatus @default(ACTIVE)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Many-to-many:
  // a member can belong to multiple teams
  teams Team[]

  createdProjects  Project[]  @relation("ProjectCreator")
  createdWorkItems WorkItem[] @relation("WorkItemCreator")
  createdTasks     Task[]     @relation("TaskCreator")

  assignedTasks Task[] @relation("TaskAssignee")

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@unique([organizationId, email])
  @@index([organizationId])
}


// ======================================================
// TEAM
// ======================================================

model TeamMember {
  memberId String
  teamId   String

  member Member @relation(
    fields: [memberId],
    references: [id],
    onDelete: Cascade
  )

  team Team @relation(
    fields: [teamId],
    references: [id],
    onDelete: Cascade
  )

  @@id([memberId, teamId])
  @@index([teamId])
}

model Team {
  id          String @id @default(uuid())
  workspaceId String

  name        String
  description String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

// Many-to-many relation through TeamMember
  members Member[]

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([workspaceId])
}

// ======================================================
// PROJECT
// ======================================================

model Project {
  id          String @id @default(uuid())
  workspaceId String
  teamId      String?

  createdById String

  name        String
  description String?

  status ProjectStatus @default(ACTIVE)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  createdBy Member @relation("ProjectCreator", fields: [createdById], references: [id])

  backlogs Backlog[]
  sprints  Sprint[]

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([workspaceId])
  @@index([teamId])
  @@index([createdById])
}


// ======================================================
// BACKLOG
// ======================================================

model Backlog {
  id        String @id @default(uuid())
  projectId String

  name        String
  description String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  workItems WorkItem[]

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@unique([projectId, name])
  @@index([projectId])
}


// ======================================================
// WORK ITEM
// ======================================================

model WorkItem {
  id          String @id @default(uuid())
  backlogId   String
  createdById String

  title       String
  description String?

  type     WorkItemType
  priority Priority       @default(MEDIUM)
  status   WorkItemStatus @default(OPEN)

  backlog Backlog @relation(fields: [backlogId], references: [id], onDelete: Cascade)

  createdBy Member @relation("WorkItemCreator", fields: [createdById], references: [id])

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([backlogId])
  @@index([createdById])
}


// ======================================================
// SPRINT
// ======================================================

model Sprint {
  id        String @id @default(uuid())
  projectId String

  name String
  goal String?

  status SprintStatus @default(PLANNED)

  startDate DateTime?
  endDate   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([projectId])
}


// ======================================================
// TASK
// ======================================================

model Task {
  id String @id @default(uuid())

  workItemId String
  createdById String

  // Optional because a task can exist before sprint planning
  sprintId String?

  // Optional because a task may be unassigned
  assigneeId String?

  title       String
  description String?

  requirements       String?
  acceptanceCriteria String?

  priority Priority   @default(MEDIUM)
  status   TaskStatus @default(TODO)

  dueDate     DateTime?
  completedAt DateTime?

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  sprint Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  assignee Member? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdBy Member @relation("TaskCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([workItemId])
  @@index([sprintId])
  @@index([assigneeId])
  @@index([createdById])
  @@index([status])
}
