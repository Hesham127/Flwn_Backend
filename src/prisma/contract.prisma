// use prisma-next

// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ======================================================
// ENUMS
// ======================================================

enum MemberType {
  HUMAN
  AI
}

enum MemberRole {
  TEAM_LEAD
  DEVELOPER
  AI_DEVELOPER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum WorkItemType {
  FEATURE
  STORY
  BUG
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkItemStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}


// ======================================================
// ORGANIZATION
// ======================================================

model Organization {
  id          String  @id @default(uuid())
  name        String
  description String?

  workspaces Workspace[]
  members    Member[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// ======================================================
// WORKSPACE
// ======================================================

model Workspace {
  id             String @id @default(uuid())
  organizationId String

  name        String
  description String?

  organization Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  teams    Team[]
  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}


// ======================================================
// MEMBER
// ======================================================

model Member {
  id             String @id @default(uuid())
  organizationId String

  name  String
  email String

  type   MemberType
  role   MemberRole
  status MemberStatus @default(ACTIVE)

  organization Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  // Many-to-many:
  // a member can belong to multiple teams
  teams Team[]

  createdProjects  Project[]  @relation("ProjectCreator")
  createdWorkItems WorkItem[] @relation("WorkItemCreator")
  createdSprints   Sprint[]    @relation("SprintCreator")
  createdTasks     Task[]     @relation("TaskCreator")

  assignedTasks Task[] @relation("TaskAssignee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId])
}


// ======================================================
// TEAM
// ======================================================

model Team {
  id          String @id @default(uuid())
  workspaceId String

  name        String
  description String?

  workspace Workspace @relation(
    fields: [workspaceId],
    references: [id],
    onDelete: Cascade
  )

  // Implicit many-to-many relation
  members Member[]

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}


// ======================================================
// PROJECT
// ======================================================

model Project {
  id          String @id @default(uuid())
  workspaceId String
  teamId      String?

  createdById String

  name        String
  description String?

  status ProjectStatus @default(ACTIVE)

  workspace Workspace @relation(
    fields: [workspaceId],
    references: [id],
    onDelete: Cascade
  )

  team Team? @relation(
    fields: [teamId],
    references: [id],
    onDelete: SetNull
  )

  createdBy Member @relation(
    "ProjectCreator",
    fields: [createdById],
    references: [id]
  )

  backlogs Backlog[]
  workItems WorkItem[]
  sprints  Sprint[]
  tasks    Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([teamId])
  @@index([createdById])
}


// ======================================================
// BACKLOG
// ======================================================

model Backlog {
  id        String @id @default(uuid())
  projectId String

  name        String
  description String?

  project Project @relation(
    fields: [projectId],
    references: [id],
    onDelete: Cascade
  )

  workItems WorkItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
}


// ======================================================
// WORK ITEM
// ======================================================

model WorkItem {
  id          String @id @default(uuid())
  projectId   String
  backlogId   String
  createdById String

  title       String
  description String?

  type     WorkItemType
  priority Priority       @default(MEDIUM)
  status   WorkItemStatus @default(OPEN)

  project Project @relation(
    fields: [projectId],
    references: [id],
    onDelete: Cascade
  )

  backlog Backlog @relation(
    fields: [backlogId],
    references: [id],
    onDelete: Cascade
  )

  createdBy Member @relation(
    "WorkItemCreator",
    fields: [createdById],
    references: [id]
  )

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
  @@index([projectId, priority])
  @@index([backlogId])
  @@index([createdById])
}


// ======================================================
// SPRINT
// ======================================================

model Sprint {
  id        String @id @default(uuid())
  projectId String
  createdById String

  name String
  goal String?

  status SprintStatus @default(PLANNED)

  startDate DateTime?
  endDate   DateTime?

  project Project @relation(
    fields: [projectId],
    references: [id],
    onDelete: Cascade
  )

  createdBy Member @relation(
    "SprintCreator",
    fields: [createdById],
    references: [id]
  )

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId, status])
  @@index([projectId, startDate])
  @@index([createdById])
}


// ======================================================
// TASK
// ======================================================

model Task {
  id        String @id @default(uuid())

  projectId String
  workItemId String
  createdById String

  // Optional because a task can exist before sprint planning
  sprintId String?

  // Optional because a task may be unassigned
  assigneeId String?

  title       String
  description String?

  requirements       String?
  acceptanceCriteria String?

  priority Priority   @default(MEDIUM)
  status   TaskStatus @default(TODO)

  dueDate     DateTime?
  completedAt DateTime?

  project Project @relation(
    fields: [projectId],
    references: [id],
    onDelete: Cascade
  )

  workItem WorkItem @relation(
    fields: [workItemId],
    references: [id],
    onDelete: Cascade
  )

  sprint Sprint? @relation(
    fields: [sprintId],
    references: [id],
    onDelete: SetNull
  )

  assignee Member? @relation(
    "TaskAssignee",
    fields: [assigneeId],
    references: [id],
    onDelete: SetNull
  )

  createdBy Member @relation(
    "TaskCreator",
    fields: [createdById],
    references: [id],
    onDelete: Restrict
  )

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
  @@index([projectId, sprintId])
  @@index([projectId, assigneeId])
  @@index([projectId, createdById])
  @@index([workItemId])
  @@index([sprintId])
  @@index([assigneeId])
  @@index([createdById])
  @@index([status])
}