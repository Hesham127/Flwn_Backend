# Copy this file to `.env` and replace the placeholders with your real values.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

# Local dev database
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/<dbname>"

# Remote Azure database
DATABASE_URL_REMOTE="postgresql://<user>:<password>@<your-server>.postgres.database.azure.com:5432/<dbname>?sslmode=require"

# AI layer service URL
AI_engine_URL="http://localhost:8000"
